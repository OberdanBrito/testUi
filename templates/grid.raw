<section class="page">
  <header class="page-header">
    <div class="page-header-identity">
      <nav class="page-breadcrumb" aria-label="breadcrumbs"></nav>
      <div class="page-pretitle"></div>
      <div class="page-title-row">
        <span class="page-icon material-symbols-rounded" aria-hidden="true"></span>
        <h1 class="page-title"></h1>
      </div>
      <p class="page-subtitle"></p>
    </div>
    <div class="page-header-actions"></div>
  </header>
  <div class="page-body">
    <div class="card grid-card">
      <div class="card-body border-bottom py-3">
        <div class="d-flex">
          <div class="text-secondary">
            Show
            <div class="mx-2 d-inline-block">
              <input type="text" class="form-control form-control-sm grid-page-size" value="8" size="3" aria-label="Entries per page">
            </div>
            entries
          </div>
          <div class="ms-auto text-secondary">
            Search:
            <div class="ms-2 d-inline-block">
              <input type="text" class="form-control form-control-sm grid-search" aria-label="Search">
            </div>
          </div>
        </div>
      </div>
      <div class="table-responsive">
        <div class="grid-container"></div>
      </div>
      <div class="card-footer">
        <div class="row g-2 justify-content-center justify-content-sm-between">
          <div class="col-auto d-flex align-items-center">
            <p class="m-0 text-secondary grid-page-info"></p>
          </div>
          <div class="col-auto">
            <nav aria-label="Pagination">
              <ul class="pagination m-0 ms-auto grid-pagination"></ul>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
